#!/bin/bash
set -e -o pipefail

echo "* Nuking any existing NeoVim configuration"

# Nuke any existing neovim configuration
# neovim config files, here the lazyvim git repo is cloned
rm -rf ~/.config/nvim
# Some lua-related stuff
rm -rf ~/.cache/nvim
# All plugins, gems and lua stuff goes here
rm -rf ~/.local/share/nvim
# lazyvim/nvim logs go here
rm -rf ~/.local/state/nvim

# Install basic tools
echo -e "\n* Installing basic tools"
sudo apt install git -y

# LazyGit is awesome
echo -e "\n* Installing lazygit"
sudo apt install lazygit -y

# Install basic LazyVim dependencies
echo -e "\n* Installing basic LazyVim dependencies"
sudo apt install fzf ripgrep fd-find -y

# Install neovim. Need to install the one from snap:
# apt-based is older and lazyvim requires 0.11+
echo -e "\n* Installing NeoVim"
sudo apt autoremove --purge neovim
sudo snap install nvim --classic

# Configure LazyVim according to https://www.lazyvim.org/installation
echo -e "\n* Configuring NeoVim for LazyVim"
git clone https://github.com/LazyVim/starter ~/.config/nvim
# Use light theme
mkdir -p ~/.config/nvim/lua/plugins/
cp *.lua ~/.config/nvim/lua/plugins/

# Enable LazyVim extras by writing lazyvim.json, the file :LazyExtras itself maintains, so they stay toggleable there.
# Both version fields are needed: without "version" LazyVim migrates the file as the oldest format and double-prefixes
# every extra; without "install_version" it assumes an old install and keeps the legacy picker/explorer defaults.
echo -e "\n* Enabling LazyVim extras"
extras=(coding.mini-surround coding.yanky dap.core lang.ruby test.core)
# jdtls needs a JDK; without one lang.java only produces errors
if command -v java >/dev/null; then
  extras+=(lang.java)
else
  echo "* WARN: no java on PATH, skipping lang.java but continuing"
fi
json_extras=$(printf '    "lazyvim.plugins.extras.%s",\n' "${extras[@]}")
cat > ~/.config/nvim/lazyvim.json <<EOF
{
  "extras": [
${json_extras%,}
  ],
  "install_version": 8,
  "version": 8
}
EOF

# Done!
echo -e "\n* Done. Now:"
echo "- Run nvim from the Alacritty terminal"
echo "- Once everything installs, run :LazyHealth"
