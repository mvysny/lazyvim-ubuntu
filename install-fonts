#!/bin/bash
set -e -o pipefail

# Nerd Fonts: downloaded from https://www.nerdfonts.com/
# Used by lazyvim a lot, for all sorts of ascii graphics, keyboard characters etc.
# You want this, otherwise lazyvim will show lots of missing characters.
# Necessary for Alacritty

FONTS_DIR="$HOME/.local/share/fonts"

# Installs Nerd Font $1 (the release zip's base name, e.g. UbuntuMono) unless already present.
install_nerd_font() {
  local name="$1"
  if [[ -e "$FONTS_DIR/${name}NerdFont-Regular.ttf" ]]; then
    echo -e "\n* $name Nerd Font already installed"
    return
  fi

  echo -e "\n* Downloading $name Nerd Font"
  mkdir -p "$FONTS_DIR"
  local zip
  zip="$(mktemp --suffix=.zip)"
  curl -fLo "$zip" "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/$name.zip"
  # only the fonts, not the readme/license; -o overwrites a half-finished earlier run without prompting
  unzip -oq "$zip" '*.ttf' -d "$FONTS_DIR"
  rm "$zip"

  # update font cache. Rarely that fails - just skip it
  fc-cache -f || echo "* WARN: fc-cache failed but continuing"
  if ! fc-list -q "$name Nerd Font"; then
    echo "* ERROR: $name Nerd Font installed but fc-list can't find it" >&2
    exit 1
  fi
}

install_nerd_font UbuntuMono
install_nerd_font JetBrainsMono
